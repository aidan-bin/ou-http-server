{
	"version": 6,
	"configurePresets": [
		{
			"name": "default",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}-${hostSystemName}"
		},
		{
			"name": "no-https",
			"inherits": "default",
			"cacheVariables": { "DISABLE_HTTPS": "ON" }
		},
		{
			"name": "asan",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SANITIZE": "address,undefined" }
		},
		{
			"name": "ubsan",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SANITIZE": "undefined" }
		},
		{
			"name": "tsan",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SANITIZE": "thread" }
		},
		{
			"name": "fuzz",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SANITIZE": "address,undefined", "FUZZ": "ON" }
		},
		{
			"name": "bench",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "DISABLE_HTTPS": "ON" }
		},
		{
			"name": "coverage",
			"inherits": "default",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "COVERAGE": "ON" }
		}
	],
	"buildPresets": [
		{ "name": "default", "configurePreset": "default" },
		{ "name": "no-https", "configurePreset": "no-https" },
		{ "name": "asan", "configurePreset": "asan" },
		{ "name": "ubsan", "configurePreset": "ubsan" },
		{ "name": "tsan", "configurePreset": "tsan" },
		{ "name": "fuzz", "configurePreset": "fuzz" },
		{ "name": "bench", "configurePreset": "bench", "targets": ["ou_http_server"] },
		{ "name": "coverage", "configurePreset": "coverage" },
		{ "name": "tidy", "configurePreset": "default", "targets": ["tidy"] }
	],
	"testPresets": [
		{ "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true }, "execution": { "jobs": 4 } },
		{ "name": "no-https", "inherits": "default", "configurePreset": "no-https" },
		{ "name": "asan", "inherits": "default", "configurePreset": "asan" },
		{ "name": "ubsan", "inherits": "default", "configurePreset": "ubsan" },
		{ "name": "tsan", "inherits": "default", "configurePreset": "tsan" },
		{ "name": "fuzz", "inherits": "default", "configurePreset": "fuzz" },
		{
			"name": "coverage",
			"inherits": "default",
			"configurePreset": "coverage",
			"environment": { "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage-${hostSystemName}/profiles/%p.profraw" }
		}
	],
	"workflowPresets": [
		{
			"name": "default",
			"steps": [
				{ "type": "configure", "name": "default" },
				{ "type": "build", "name": "default" },
				{ "type": "test", "name": "default" }
			]
		},
		{
			"name": "no-https",
			"steps": [
				{ "type": "configure", "name": "no-https" },
				{ "type": "build", "name": "no-https" },
				{ "type": "test", "name": "no-https" }
			]
		},
		{
			"name": "asan",
			"steps": [
				{ "type": "configure", "name": "asan" },
				{ "type": "build", "name": "asan" },
				{ "type": "test", "name": "asan" }
			]
		},
		{
			"name": "ubsan",
			"steps": [
				{ "type": "configure", "name": "ubsan" },
				{ "type": "build", "name": "ubsan" },
				{ "type": "test", "name": "ubsan" }
			]
		},
		{
			"name": "tsan",
			"steps": [
				{ "type": "configure", "name": "tsan" },
				{ "type": "build", "name": "tsan" },
				{ "type": "test", "name": "tsan" }
			]
		},
		{
			"name": "fuzz",
			"steps": [
				{ "type": "configure", "name": "fuzz" },
				{ "type": "build", "name": "fuzz" },
				{ "type": "test", "name": "fuzz" }
			]
		},
		{
			"name": "coverage",
			"steps": [
				{ "type": "configure", "name": "coverage" },
				{ "type": "build", "name": "coverage" },
				{ "type": "test", "name": "coverage" }
			]
		}
	]
}
